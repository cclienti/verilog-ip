VERIPARSE_MK_DIR  := $(realpath $(dir $(lastword $(MAKEFILE_LIST))))

# Every veriparse tool runs from one pinned release, installed in a
# micromamba prefix environment local to the repository and created on
# first use, as verilator.mk does for Verilator. The release ships one
# conda package per platform on GitHub, not on a public channel: it is
# downloaded into a local channel, indexed, and installed from there
# with conda-forge beside it, which is what resolves its runtime
# dependencies -- installing the .conda file directly skips them and the
# tools fail to start. That first run needs network access.
#
# Bumping VERIPARSE_VERSION reinstalls on the next use: the target is the
# package's own conda-meta record, so it names the version. Override
# VERIFLAT, VERIOBF or VERILOWER to use another build, a development
# checkout for instance; the environment is then never created.
MAMBA                  ?= micromamba
VERIPARSE_VERSION      ?= v2.0.0
VERIPARSE_BUILD        ?= 0
VERIPARSE_ENV_DIR      ?= $(VERIPARSE_MK_DIR)/.veriparse-env
VERIPARSE_CHANNEL_DIR  ?= $(VERIPARSE_MK_DIR)/.veriparse-channel
VERIPARSE_INDEX_ENV    ?= $(VERIPARSE_MK_DIR)/.veriparse-index-env
VERIPARSE_RELEASES     ?= https://github.com/cclienti/veriparse/releases/download

# Simple on purpose: the stamp rule's target and the order-only
# prerequisites expand it while the makefile is read, on every make
# invocation, and a recursive definition re-ran both uname calls at
# each expansion -- ten processes for a plain `make help`.
VERIPARSE_SUBDIR       := $(shell uname -s | sed 's/^Linux$$/linux/; s/^Darwin$$/osx/')-$(shell \
                            uname -m | sed 's/^x86_64$$/64/; s/^aarch64$$/arm64/')
VERIPARSE_PKG           = veriparse-$(VERIPARSE_VERSION)-$(subst -,_,$(VERIPARSE_SUBDIR))_$(VERIPARSE_BUILD)
VERIPARSE_STAMP         = $(VERIPARSE_ENV_DIR)/conda-meta/$(VERIPARSE_PKG).json

VERIPARSE_RUN           = $(MAMBA) run -p $(VERIPARSE_ENV_DIR)
VERIFLAT               ?= $(VERIPARSE_RUN) veriflat
VERIOBF                ?= $(VERIPARSE_RUN) veriobf
VERILOWER              ?= $(VERIPARSE_RUN) verilower

# The environment as a prerequisite of the targets running $1, empty
# when $1 was overridden away from it.
veriparse-env-dep       = $(if $(findstring $(VERIPARSE_ENV_DIR),$1),$(VERIPARSE_STAMP))

VERIFLAT_FLAGS    += --seed 0
VERIOBF_FLAGS     += --id-length 16 --seed 0

REPO_PATH	   = $(shell git rev-parse --show-toplevel)
VERIFLAT_PP_DIR    = preproc

VERIFLAT_INPUTS    = $(ALL_TOP_FILES)
VERIFLAT_PP        = $(subst $(REPO_PATH),$(VERIFLAT_PP_DIR),$(abspath $(VERIFLAT_INPUTS:.v=.pp)))

VERIFLAT_OUTPUT    = $(TOP_MODULE)_flat.v
VERIOBF_INPUT      = $(VERIFLAT_OUTPUT)
VERIOBF_OUTPUT     = $(TOP_MODULE)_obf.v

# verilower compiles an `initial` process marked (* veriparse_fsm *)
# into the explicit state machine. A project lists the lowered files it
# keeps in VERILOWER_OUTPUTS; each <module>.sv is lowered from the
# behavioural source beside it, <module>.beh.sv, whose module carries the
# same name. Both are committed: simulation and synthesis read the
# lowered file like any hand-written one and need no environment, and a
# diff shows what the tool changed. lower.verilower regenerates them,
# check.verilower fails when one is stale or was edited by hand, and
# neither clean nor distclean removes them.
#
# VERILOWER_DEPS are extra sources handed to every lowering -- the
# packages a behavioural source imports. VERILOWER_FLAGS reaches every
# invocation: -p for a parameter map, -I, -D.
VERILOWER_OUTPUTS ?=
VERILOWER_SRC_EXT ?= .beh.sv
VERILOWER_DEPS    ?=
VERILOWER_FLAGS   += --sv

# Shell function lowering $1 into $2, plus the state map $2.fsm.json.
# The tool writes both files as temporaries, so a failed run never
# truncates a committed one, and the temporaries are tested because
# verilower exits 0 without writing anything when the output directory
# does not exist.
# The banner names the tool version as the tool reports it, which an
# override would otherwise misstate.
VERILOWER_FN = lower() { \
	  top=$$(basename $$2 .sv); \
	  ver=$$($(VERILOWER) --version 2>/dev/null | head -1); \
	  mkdir -p $$(dirname $$2) && rm -f $$2.tmp $$2.fsm.json.tmp && \
	  $(VERILOWER) $(VERILOWER_FLAGS) -t $$top --state-map $$2.fsm.json.tmp -o $$2.tmp $$1 $(VERILOWER_DEPS) && \
	  test -s $$2.tmp && test -s $$2.fsm.json.tmp && \
	  { printf '// Generated by verilower %s from %s.\n// Edit that file and run make lower.verilower, never this one.\n\n' \
	      "$$ver" "$$(basename $$1)"; cat $$2.tmp; } > $$2 && \
	  mv -f $$2.fsm.json.tmp $$2.fsm.json && \
	  rm -f $$2.tmp; \
	}


.PHONY: flatten.veriparse obfuscate.veriparse env.veriparse clean.veriparse
.PHONY: lower.verilower check.verilower

HELP_ENTRIES += 'flatten.veriparse|flatten the design'
HELP_ENTRIES += 'obfuscate.veriparse|obfuscate the flattened design'
HELP_ENTRIES += 'env.veriparse|create the micromamba env holding veriparse $(VERIPARSE_VERSION)'
ifneq ($(VERILOWER_OUTPUTS),)
HELP_ENTRIES += 'lower.verilower|regenerate the committed FSMs from their .beh.sv sources'
HELP_ENTRIES += 'check.verilower|fail when a committed FSM differs from a fresh lowering'
endif

# The index environment only serves this recipe and weighs more than
# the tool environment, so it goes once the channel is indexed. The
# channel stays: it is a few megabytes, and the next version is added
# beside it.
$(VERIPARSE_STAMP):
	mkdir -p $(VERIPARSE_CHANNEL_DIR)/$(VERIPARSE_SUBDIR)
	curl -sSfL -o $(VERIPARSE_CHANNEL_DIR)/$(VERIPARSE_SUBDIR)/$(VERIPARSE_PKG).conda \
	     $(VERIPARSE_RELEASES)/$(VERIPARSE_VERSION)/$(VERIPARSE_PKG).conda
	$(MAMBA) create -y -q -p $(VERIPARSE_INDEX_ENV) -c conda-forge conda-index
	$(MAMBA) run -p $(VERIPARSE_INDEX_ENV) python -m conda_index $(VERIPARSE_CHANNEL_DIR)
	$(MAMBA) env remove -y -q -p $(VERIPARSE_INDEX_ENV)
	$(MAMBA) create -y -q -p $(VERIPARSE_ENV_DIR) \
	     -c file://$(VERIPARSE_CHANNEL_DIR) -c conda-forge 'veriparse=$(VERIPARSE_VERSION)'
	@test -f $@ || { echo "veriparse installed, but $@ is missing"; exit 1; }

env.veriparse: $(VERIPARSE_STAMP)

obfuscate.veriparse: $(VERIOBF_OUTPUT)

flatten.veriparse: $(VERIFLAT_OUTPUT)

$(VERIOBF_OUTPUT): $(VERIOBF_INPUT) | $(call veriparse-env-dep,$(VERIOBF))
	@$(VERIOBF) $(VERIOBF_FLAGS) --output $@ $^

$(VERIFLAT_OUTPUT): $(VERIFLAT_PP) | $(call veriparse-env-dep,$(VERIFLAT))
	@$(VERIFLAT) $(VERIFLAT_FLAGS) --output $@ --top-module $(TOP_MODULE) $^

preproc/%.pp: $(REPO_PATH)/%.v
	@echo "Preprocessing $<"
	@mkdir -p $(dir $@)
	@$(IVERILOG) $(IVFLAGS) -E $< -o $@

lower.verilower: $(VERILOWER_OUTPUTS)

$(VERILOWER_OUTPUTS): %.sv: %$(VERILOWER_SRC_EXT) $(VERILOWER_DEPS) | $(call veriparse-env-dep,$(VERILOWER))
	@$(VERILOWER_FN); lower $< $@

# Lowers each source again into a scratch directory, under the same
# file name -- the module name is taken from it -- and compares both
# the RTL and the state map with the committed pair.
check.verilower: | $(call veriparse-env-dep,$(VERILOWER))
	@$(VERILOWER_FN); fail=0; tmp=$$(mktemp -d); \
	for out in $(VERILOWER_OUTPUTS); do \
	  src=$${out%.sv}$(VERILOWER_SRC_EXT); fresh=$$tmp/$$(basename $$out); \
	  if ! lower $$src $$fresh; then fail=1; continue; fi; \
	  diff -u $$out $$fresh || fail=1; \
	  diff -u $$out.fsm.json $$fresh.fsm.json || fail=1; \
	done; \
	rm -rf $$tmp; \
	if [ $$fail -ne 0 ]; then echo "verilower: committed FSMs out of date, run make lower.verilower"; exit 1; fi; \
	echo "verilower: $(words $(VERILOWER_OUTPUTS)) committed FSM(s) up to date"

clean:: clean.veriparse

# The lowered files are committed and stay. So does the environment,
# shared by every project; drop it with
# `$(MAMBA) env remove -p $(VERIPARSE_ENV_DIR)`.
clean.veriparse:
	rm -rf $(VERIOBF_OUTPUT) $(VERIOBF_TESTBENCH) veriobf.log
	rm -rf $(VERIFLAT_PP_DIR) $(VERIFLAT_OUTPUT) $(VERIFLAT_TESTBENCH) veriflat.log
	rm -f $(addsuffix .tmp,$(VERILOWER_OUTPUTS)) $(addsuffix .fsm.json.tmp,$(VERILOWER_OUTPUTS))
