**/build/

##################
# Verilog simulation
##################
**/project/*.fst
**/project/*.fst.hier
**/project/*.lxt2
# Dumps from before the switch to FST, and other simulators' output.
**/project/*.vcd
**/project/*_tb
# A project with several testbenches names them <module>_tb2 and up, and
# a gitignore pattern must match the whole name -- *_tb ends there, so
# those escaped it. hynoc_router_5p builds four, 0.5 to 1.4 MB each.
# Bounded to a single digit so the tracked <testbench>.sav views, and any
# other suffixed source, stay visible.
**/project/*_tb[0-9]
**/project/*_postsyn

##################
# Verilator
##################
**/project/obj_dir/
**/project/verilator/lib/
**/project/verilator/check/
# micromamba prefix env holding the pinned verilator (env.verilator)
hw/Makefiles/.verilator-env/
*.o
*.a
*.d

